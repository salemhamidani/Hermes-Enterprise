# Hermes Enterprise Stack (HES)
# File: .env.example
# Purpose: Example environment configuration for Phase 1 infrastructure.
# Copy this file to .env and adjust values before running the stack.

HES_PROJECT_NAME=hermes-enterprise
HES_ENVIRONMENT=development
HES_DOMAIN=example.com
HES_ADMIN_EMAIL=admin@example.com

# Paths are relative to the project root unless absolute paths are supplied.
HES_WORKSPACE_DIR=./workspace
HES_LOG_DIR=./logs
HES_BACKUP_DIR=./backup
HES_STORAGE_DIR=./storage
HES_SSL_DIR=./ssl
HES_DATA_DIR=./data
HES_CONFIG_DIR=./config

# Docker Compose
HES_COMPOSE_PROJECT_NAME=hes
HES_RESTART_POLICY=unless-stopped

# Networking
HES_PUBLIC_NETWORK=hes-production-public
HES_FRONTEND_NETWORK=hes-production-frontend
HES_BACKEND_NETWORK=hes-production-backend
HES_MANAGEMENT_NETWORK=hes-production-management
HES_INTERNAL_NETWORK=hes-production-internal

# Traefik
HES_TRAEFIK_IMAGE=traefik:v3.3
HES_TRAEFIK_HTTP_PORT=80
HES_TRAEFIK_HTTPS_PORT=443
HES_TRAEFIK_LOG_LEVEL=INFO
HES_TRAEFIK_LOG_FORMAT=json
HES_TRAEFIK_ACCESS_LOG_ENABLED=true
HES_TRAEFIK_ACCESS_LOG_FILE=/var/log/traefik/access/access.log
HES_TRAEFIK_APP_LOG_FILE=/var/log/traefik/application/traefik.log
HES_TRAEFIK_METRICS_ENABLED=true
HES_TRAEFIK_METRICS_ENTRYPOINT=metrics
HES_TRAEFIK_PING_ENTRYPOINT=traefik
HES_TRAEFIK_DOCKER_ENDPOINT=tcp://docker-socket-proxy:2375
HES_TRAEFIK_CERT_RESOLVER=letsencrypt
HES_TRAEFIK_ACME_STORAGE=/letsencrypt/acme.json
HES_TRAEFIK_ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
HES_TRAEFIK_ACME_STAGING_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Docker socket proxy
HES_SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:0.3.0
HES_SOCKET_PROXY_LOG_LEVEL=info

# Docker log rotation
HES_DOCKER_LOG_MAX_SIZE=10m
HES_DOCKER_LOG_MAX_FILE=5

# Backup and restore
HES_BACKUP_RETENTION_DAYS=14
HES_BACKUP_PREFIX=hes-backup
HES_RESTORE_ARCHIVE=

# Destructive operations must be explicitly enabled.
HES_REMOVE_DATA=false
